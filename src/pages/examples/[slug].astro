---
import Layout from '../../layouts/Layout.astro';
import ExampleCards from '../../components/ExampleCards.astro';
import { examples, groups, groupIntro, methodReferences } from '../../data/showcase';
import { showcaseGroups, showcaseTable } from '../../lib/showcase-specs';
import { chartFrames, chartDescription } from '../../lib/chart-options';
import '../../styles/examples.css';
export function getStaticPaths() {
  return [
    ...examples.map((example) => ({ params: { slug: example.slug }, props: { example, group: undefined } })),
    ...groups.map((group) => ({ params: { slug: group.slug }, props: { group, example: undefined } })),
  ];
}
const { example: e, group: g } = Astro.props;
const title = e?.title ?? g!.name;
const answer = e?.answer ?? groupIntro[g!.kind].answer;
const description = e
  ? `${e.title} with original data, worked interpretation and free SVG, PNG and CSV downloads. Open the exact example in the ChartsAI editor.`
  : answer;
const path = `/examples/${Astro.params.slug}/`;
const url = `https://www.chartsai.com${path}`;
const parent = e ? showcaseGroups[e.spec.kind] : undefined;
const asset = e ? `/examples/assets/${e.slug}` : '';
const rows = e ? showcaseTable(e.spec) : [];
const dimensions = e ? chartFrames[e.spec.frame] : undefined;
const related = e
  ? examples.filter((item) => item.spec.kind === e.spec.kind && item.slug !== e.slug).slice(0, 3)
  : [];
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Chart examples', path: '/examples/' },
  ...(parent ? [{ name: parent.name, path: `/examples/${parent.slug}/` }] : []),
  { name: title, path },
];
const schema: Record<string, unknown>[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: `https://www.chartsai.com${c.path}`,
    })),
  },
];
if (e) {
  schema.push({
    '@type': 'Article',
    '@id': `${url}#example`,
    headline: title,
    description: e.answer,
    datePublished: '2026-09-08',
    dateModified: '2026-09-08',
    author: { '@id': 'https://www.chartsai.com/#organization' },
    image: `https://www.chartsai.com${asset}.png`,
    mainEntityOfPage: { '@id': `${url}#webpage` },
    isAccessibleForFree: true,
  });
  schema.push({
    '@type': 'Dataset',
    name: `${title} — fictional data`,
    description: `Original fictional teaching data. ${e.answer}`,
    url: `${url}#data`,
    creator: { '@id': 'https://www.chartsai.com/#organization' },
    license: 'https://www.chartsai.com/source/',
    isAccessibleForFree: true,
    distribution: {
      '@type': 'DataDownload',
      encodingFormat: 'text/csv',
      contentUrl: `https://www.chartsai.com${asset}.csv`,
    },
  });
} else {
  schema.push({
    '@type': 'CollectionPage',
    name: title,
    description: answer,
    hasPart: g!.examples.map((item) => ({
      '@type': 'WebPage',
      name: item.title,
      url: `https://www.chartsai.com/examples/${item.slug}/`,
    })),
  });
}
---

<Layout
  title={`${title} — Data & Free Downloads | ChartsAI`}
  description={description}
  schema={schema}
  imagePath={e ? `${asset}.png` : undefined}
  imageAlt={e ? chartDescription(e.spec) : undefined}
  imageWidth={dimensions?.width}
  imageHeight={dimensions?.height}
>
  <div class="container example-breadcrumb">
    <nav aria-label="Breadcrumb">
      {
        crumbs.slice(0, -1).map((c) => (
          <>
            <>
              <a href={c.path}>{c.name}</a>
              <span aria-hidden="true"> / </span>
            </>
          </>
        ))
      }
    </nav>
  </div>
  <section class="container example-intro example-detail-intro">
    <span class="eyebrow">{e ? 'THE CHART, THE DATA, THE EXPLANATION' : 'EXPLORE THE COLLECTION'}</span><h1>
      {title}
    </h1><p>{answer}</p>{
      e && (
        <div class="example-actions">
          <>
            <a class="button" href={`${parent!.tool}?showcase=${e.slug}#editor`}>
              Edit this chart <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#data">
              Inspect the data ↓
            </a>
          </>
        </div>
      )
    }
  </section>
  {
    e ? (
      <>
        <section class="container example-output" aria-label="Finished chart">
          <>
            <figure>
              <>
                <img
                  src={`${asset}.svg`}
                  width={dimensions!.width}
                  height={dimensions!.height}
                  alt={chartDescription(e.spec)}
                  fetchpriority="high"
                />
                <figcaption>
                  Original fictional data · Made with Apache ECharts · {dimensions!.width} ×{' '}
                  {dimensions!.height} export
                </figcaption>
              </>
            </figure>
            <div class="example-downloads">
              <span>Take the example</span>
              {['svg', 'png', 'csv', 'json'].map((format) => (
                <a href={`${asset}.${format}`} download data-showcase-download={e.slug} data-format={format}>
                  {format === 'json' ? 'ECharts JSON' : format.toUpperCase()} ↓
                </a>
              ))}
            </div>
          </>
        </section>
        <div class="container example-body">
          <article class="example-explanation">
            <>
              <section>
                <h2>How to read this chart</h2>
                {e.reading.map((p) => (
                  <p>{p}</p>
                ))}
              </section>
              <section>
                <h2>Build it with your own data</h2>
                {e.method.map((p) => (
                  <p>{p}</p>
                ))}
                <p>
                  <a href={`${parent!.tool}?showcase=${e.slug}#editor`}>
                    Open this example in the{' '}
                    {e.spec.kind === 'dot'
                      ? 'dot plot'
                      : e.spec.kind === 'line'
                        ? 'line graph'
                        : 'radar chart'}{' '}
                    maker →
                  </a>{' '}
                  Replace the data, inspect the preview and download your version. SVG, PNG and PDF exports
                  are available in the editor.
                </p>
              </section>
              <section class="example-caution">
                <>
                  <h2>What this example cannot tell you</h2>
                  <p>{e.caution}</p>
                </>
              </section>
              <section>
                <>
                  <h2>{e.question}</h2>
                  <p>{e.response}</p>
                </>
              </section>
              {methodReferences[e.slug] && (
                <p class="example-reference">
                  Method background:{' '}
                  <a href={methodReferences[e.slug]!.url}>{methodReferences[e.slug]!.name}</a>. Our dataset
                  and worked calculation are original fictional examples.
                </p>
              )}
              <p class="example-credit">
                Created and reviewed by <a href="https://www.supamakers.com/">SupaMakers</a> for ChartsAI ·
                September 8, 2026. <a href="/source/">Source code and reuse terms</a>.
              </p>
            </>
          </article>
          <aside id="data" class="example-data">
            <>
              <span class="eyebrow">EVERY PLOTTED VALUE</span>
              <h2>The original data</h2>
              <p>Fictional observations or ratings, created for this worked example.</p>
              <div class="table-scroll">
                <table>
                  <>
                    <caption class="sr-only">{title}: complete data</caption>
                    <thead>
                      <tr>
                        {rows[0].map((cell) => (
                          <th scope="col">{cell}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {rows.slice(1).map((row) => (
                        <tr>
                          {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                        </tr>
                      ))}
                    </tbody>
                  </>
                </table>
              </div>
              <a
                href={`${asset}.csv`}
                download
                data-showcase-download={e.slug}
                data-format="csv"
                class="text-link"
              >
                Download this CSV ↓
              </a>
              <p class="fine-print">
                {e.spec.kind === 'dot'
                  ? 'One row per observation. Repeated values are intentional.'
                  : e.spec.kind === 'radar'
                    ? `Shared scale: 0–${e.spec.max}. Scores are supplied, not normalized.`
                    : 'Rows preserve the plotted order. Connections do not add measured observations.'}{' '}
                The ECharts JSON download contains rendering options, not an importable workbook.
              </p>
            </>
          </aside>
        </div>
        <section class="container section">
          <>
            <div class="section-heading">
              <>
                <h2>Keep exploring</h2>
                <a href={`/examples/${parent!.slug}/`} class="text-link">
                  All {parent!.name.toLowerCase()} →
                </a>
              </>
            </div>
            <ExampleCards items={related} />
          </>
        </section>
      </>
    ) : (
      <>
        <>
          <section class="container example-collection">
            <ExampleCards items={g!.examples} />
          </section>
          <section class="container prose-section">
            {groupIntro[g!.kind].sections.map((s) => (
              <section>
                <h2>{s.title}</h2>
                <p>{s.text}</p>
              </section>
            ))}
            <p>
              <a class="button" href={g!.tool}>
                Open the free{' '}
                {g!.kind === 'line' ? 'line graph' : g!.kind === 'dot' ? 'dot plot' : 'radar chart'} maker ↗
              </a>
            </p>
            <p>
              <a href="/examples/">Browse all 50 chart examples →</a>
            </p>
          </section>
        </>
      </>
    )
  }
</Layout>
