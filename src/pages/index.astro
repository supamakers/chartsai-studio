---
import Layout from '../layouts/Layout.astro';
import HeroStudio from '../components/HeroStudio';
import { dotExample, radarExample } from '../lib/chart-presets';
import { chartDescription } from '../lib/chart-options';
import HomeFigures from '../components/HomeFigures.astro';
import '../styles/home.css';
const descriptions = {
  radar: chartDescription(radarExample('products')),
  dot: chartDescription(dotExample('scores')),
};
const collections = [
  {
    name: 'Chart makers',
    description:
      'Paste spreadsheet cells or upload CSV or Excel. Choose your columns, check the preview, and export PNG, SVG, PDF or CSV. For articles, explore the editorial collection.',
    tools: [
      ['Dot plot maker', 'dot-plot-maker', 'Show every individual observation.'],
      ['Histogram maker', 'histogram-maker', 'Group measurements into intervals.'],
      ['Box plot maker', 'box-plot-maker', 'Compare medians, quartiles and outliers.'],
      ['Scatter plot maker', 'scatter-plot-maker', 'Explore paired X and Y values.'],
      ['Line graph maker', 'line-graph-maker', 'Follow change across ordered points.'],
      ['Bar chart maker', 'bar-chart-maker', 'Compare categories side by side.'],
      ['Radar chart maker', 'radar-chart-maker', 'Compare profiles on a shared scale.'],
      ['Dumbbell chart maker', 'dumbbell-chart-maker', 'Compare two values for each category.'],
      ['Slopegraph maker', 'slopegraph-maker', 'Show change between two periods.'],
      ['Small multiples maker', 'small-multiples-chart-maker', 'Compare separate panels on one scale.'],
      ['Pareto chart maker', 'pareto-chart-maker', 'Rank categories and their cumulative share.'],
    ],
  },
  {
    name: 'Math tools',
    description:
      'Change the numbers and see the result. Explore the method, practise on paper, or print a worksheet with a separate answer key.',
    tools: [
      ['Coordinate plane generator', 'coordinate-plane-generator', 'Plot points or print a blank grid.'],
      ['Number line generator', 'number-line-generator', 'Explore fractions, jumps and intervals.'],
      ['Slope calculator', 'slope-calculator', 'Connect two points to rise and run.'],
      [
        'Geometry transformations',
        'geometry-transformation-calculator',
        'Translate, reflect, rotate and dilate.',
      ],
      [
        'Quadratic graph calculator',
        'quadratic-graph-calculator',
        'See the parabola, vertex and real roots.',
      ],
    ],
  },
  {
    name: 'Printables',
    description:
      'Make a practice set or a tracker to fill in by hand. Preview the pages, choose A4 or US Letter, and download your PDF.',
    tools: [
      ['Number line worksheets', 'number-line-worksheets', 'Create 6–12 questions with separate answers.'],
      ['Habit tracker printable', 'printables/habit-tracker', 'Plan a week or month of daily habits.'],
    ],
  },
];
const allTools = collections.flatMap((c) => c.tools);
const schema = [
  {
    '@type': 'ItemList',
    name: 'Free ChartsAI tools',
    itemListElement: allTools.map(([name, path], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name,
      url: `https://www.chartsai.com/${path}/`,
    })),
  },
];
---

<Layout
  schema={schema}
  dateModified="2026-09-09"
  title="Free Chart Makers, Math Tools & Printable Worksheets | ChartsAI"
  description="Make a chart, explore maths or print a worksheet. Eleven chart makers, five math tools, number-line practice and habit trackers. Free downloads, no signup."
>
  <div class="home-library">
    <section class="home-opening" aria-label="Free charts, math tools and printables">
      <div class="home-intro">
        <h1>
          <span
            ><span class="home-print-word home-registration">GOOD</span>{' '}<span class="home-print-word"
              >TOOLS</span
            ><span class="home-dot">.</span></span
          ><span
            ><span class="home-print-word home-registration">CLEAR</span>{' '}<span class="home-print-word"
              >IDEAS</span
            ><span class="home-dot">.</span></span
          >
        </h1>
        <p class="home-description">
          Free chart makers, math tools and printables.<br class="home-desktop-break" /> Start with an example.
          Customize it. Download it.
        </p>
        <nav class="home-launches" aria-label="Choose what to make">
          <a href="/charts/" data-home-focus="chart"
            ><span>Make a chart</span><svg viewBox="0 0 40 32" aria-hidden="true"
              ><path d="M2 16h33M22 3l13 13-13 13"></path></svg
            ></a
          >
          <a href="/math-tools/" data-home-focus="math"
            ><span>Explore math tools</span><svg viewBox="0 0 40 32" aria-hidden="true"
              ><path d="M2 16h33M22 3l13 13-13 13"></path></svg
            ></a
          >
          <a href="/printables/" data-home-focus="print"
            ><span>Find a printable</span><svg viewBox="0 0 40 32" aria-hidden="true"
              ><path d="M2 16h33M22 3l13 13-13 13"></path></svg
            ></a
          >
        </nav>
        <p class="home-assurance">No signup. Free downloads.</p>
        <p class="home-template-hero"><a href="/editorial-charts/#templates">New: 12 editable editorial templates</a></p>
        <div class="home-resource-links">
          <a href="/examples/"
            >Worked examples <svg viewBox="0 0 32 24" aria-hidden="true"
              ><path d="M1 12h27M18 2l10 10-10 10"></path></svg
            ></a
          ><span class="home-resource-group"
            ><a href="/guides/">Guides</a><span>&</span><a href="/datasets/"
              >datasets <svg viewBox="0 0 32 24" aria-hidden="true"
                ><path d="M1 12h27M18 2l10 10-10 10"></path></svg
              ></a
            ></span
          >
        </div>
      </div>
      <HomeFigures />
    </section>
    <p class="home-signoff">
      Made by <a href="https://www.supamakers.com/">SupaMakers</a>. <a href="/source/">Open source</a>. Yours
      to use.
    </p>
    <section class="home-directory" id="tools" aria-labelledby="directory-title">
      <div class="home-section-intro">
        <h2 id="directory-title">What are you making?</h2><p>
          A chart for your report. A diagram for your lesson. A page to print. Pick a tool and start with a
          working example.
        </p>
      </div>
      <div class="home-directory-columns">
        {
          collections.map((c) => (
            <section>
              <>
                <h3>{c.name}</h3>
                <p>{c.description}</p>
                <ul>
                  {c.tools.map(([name, path, description]) => (
                    <li>
                      <a href={`/${path}/`}>
                        <strong>{name}</strong>
                        <span>{description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            </section>
          ))
        }
      </div>
    </section>
    <section class="home-try" aria-labelledby="try-title">
      <div>
        <h2 id="try-title">See it.<br />Make it yours.</h2><p>
          Try a dot plot or radar chart in three styles. Choose a look, then open the maker with this exact
          example ready to edit.
        </p><p>
          Your own data works too: upload a spreadsheet or paste cells, select your columns, and check the
          values before you replace the sample.
        </p><p class="home-small-note">These previews use fictional teaching data.</p>
      </div>
      <HeroStudio client:load descriptions={descriptions} />
    </section>
    <section class="home-learn" aria-labelledby="learn-title">
      <h2 id="learn-title">Useful beyond the download.</h2>
      <p class="home-template-entry"><a href="/editorial-charts/#templates">Browse 12 editorial chart templates</a> — before/after comparisons, group gaps, rankings and trends. Free projects, data and graphics.</p>
      <div class="home-learn-links">
        <a href="/examples/"
          ><h3>Worked examples</h3><p>
            50 original examples with the source values, a worked interpretation, and reusable downloads.
          </p><span>Explore the examples</span></a
        ><a href="/guides/"
          ><h3>Chart guides</h3><p>
            20 explanations to help you choose a chart, understand its calculations, and avoid misleading
            comparisons.
          </p><span>Read the guides</span></a
        ><a href="/datasets/"
          ><h3>Public datasets</h3><p>
            Five attributed UCI datasets, with source notes and prepared CSV files for exploring the tools.
          </p><span>Find a dataset</span></a
        >
      </div>
    </section>
    <section class="home-method" aria-labelledby="method-title">
      <h2 id="method-title">Free tools. Clear methods.</h2><div>
        <p>
          <a href="/editorial-charts/#templates"
            >12 editable editorial templates: choose a visual, replace the data, keep the design.</a>
        </p>
        <p>
          ChartsAI is a free collection of chart makers, math visualization tools and printable resources
          built by <a href="https://www.supamakers.com/">SupaMakers</a>. No account or watermark is required.
        </p><p>
          Files, calculations and exports stay in your browser. Each tool explains its inputs, assumptions and
          limits. You can inspect the values, download the result, and reuse the open-source code.
        </p><div class="home-method-links">
          <a href="/about/">About our methods</a><a href="/source/">Get the source code</a><a href="/privacy/"
            >How privacy works</a
          >
        </div>
      </div>
    </section>
  </div>
</Layout>
