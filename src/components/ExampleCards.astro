---
import { examples } from '../data/showcase';
import { chartFrames } from '../lib/chart-options';
interface Props {
  items?: typeof examples;
}
const { items = examples } = Astro.props;
---

<div class="showcase-grid">
  {
    items.map((e) => (
      <article
        class="showcase-card"
        data-example-kind={e.spec.kind}
        data-example-title={`${e.title} ${e.answer}`.toLowerCase()}
      >
        <a href={`/examples/${e.slug}/`} class="showcase-card-image" tabindex="-1" aria-hidden="true">
          <img
            src={`/examples/assets/${e.slug}.svg`}
            width={chartFrames[e.spec.frame].width}
            height={chartFrames[e.spec.frame].height}
            alt=""
            loading="lazy"
          />
        </a>
        <div class="showcase-card-copy">
          <>
            <>
              <h3>
                <a href={`/examples/${e.slug}/`}>{e.title}</a>
              </h3>
              <span class="example-meta">
                {e.spec.kind === 'dot' ? 'Dot plot' : e.spec.kind === 'line' ? 'Line graph' : 'Radar chart'} ·
                Worked example
              </span>
            </>
            <p>{e.answer}</p>
            <span class="showcase-card-note">Editable chart + original data</span>
          </>
        </div>
      </article>
    ))
  }
</div>
