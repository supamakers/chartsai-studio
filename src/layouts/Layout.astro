---
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
import '../styles/studio.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
interface Props {
  title: string;
  description: string;
  path?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  imagePath?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  dateModified?: string;
}
const {
  title,
  description,
  path = Astro.url.pathname,
  schema = [],
  noindex = false,
  imagePath = '/og.png',
  imageAlt = 'ChartsAI — Free chart makers and printables by SupaMakers',
  imageWidth = 1200,
  imageHeight = 630,
  dateModified = '2026-09-08',
} = Astro.props;
const canonical = new URL(path, Astro.site).href;
const graph = [
  {
    '@type': 'Organization',
    '@id': 'https://www.chartsai.com/#organization',
    name: 'ChartsAI',
    url: 'https://www.chartsai.com/',
    parentOrganization: {
      '@type': 'Organization',
      name: 'SupaMakers',
      url: 'https://www.supamakers.com/',
    },
  },
  {
    '@type': 'WebSite',
    '@id': 'https://www.chartsai.com/#website',
    name: 'ChartsAI',
    url: 'https://www.chartsai.com/',
    publisher: { '@id': 'https://www.chartsai.com/#organization' },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': 'https://www.chartsai.com/#website' },
    inLanguage: 'en',
    dateModified,
  },
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} /><link
      rel="canonical"
      href={canonical}
    />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <meta name="theme-color" content="#f7f7ef" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" /><meta property="og:site_name" content="ChartsAI" /><meta
      property="og:title"
      content={title}
    /><meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    /><meta property="og:image" content={new URL(imagePath, Astro.site).href} /><meta
      property="og:image:width"
      content={String(imageWidth)}
    /><meta property="og:image:height" content={String(imageHeight)} /><meta
      property="og:image:alt"
      content={imageAlt}
    />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    /><meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={new URL(imagePath, Astro.site).href}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': graph,
      }).replace(/</g, '\u003c')}
    />
    <Analytics />
  </head>
  <body class:list={{ 'home-page': path === '/' }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="ChartsAI home"
          ><svg viewBox="0 0 31 31" width="30" height="30" aria-hidden="true"
            ><rect width="31" height="31" rx="9" fill="#263b34"></rect><path
              d="M8 21V16M15.5 21V9M23 21V12"
              stroke="#d9ebaa"
              stroke-width="3"
              stroke-linecap="round"></path></svg
          ><span>charts<span class="brand-ai">ai</span><span class="brand-dot">.</span></span></a
        >
        {
          path === '/' ? (
            <nav aria-label="Main navigation">
              <>
                <a href="/charts/">Charts</a>
                <a href="/math-tools/">Math tools</a>
                <a href="/printables/">Printables</a>
                <a href="/examples/">Examples</a>
              </>
            </nav>
          ) : (
            <nav aria-label="Main navigation">
              <>
                <a
                  href="/charts/"
                  aria-current={path.includes('maker') || path === '/charts/' ? 'page' : undefined}
                >
                  Chart makers
                </a>
                <a href="/examples/" aria-current={path.startsWith('/examples/') ? 'page' : undefined}>
                  Examples
                </a>
                <a href="/printables/" aria-current={path.includes('printables') ? 'page' : undefined}>
                  Printables
                </a>
                <a
                  href="/math-tools/"
                  aria-current={
                    path === '/math-tools/' || /calculator|number-line|coordinate-plane/.test(path)
                      ? 'page'
                      : undefined
                  }
                >
                  Math tools
                </a>
                <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>
                  Our approach
                </a>
              </>
            </nav>
          )
        }
        <a class="header-maker" href="https://www.supamakers.com/"
          >Built by <strong>SupaMakers{path === '/' ? '' : ' ↗'}</strong></a
        >
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-main">
          <div>
            <a class="brand" href="/"
              >charts<span class="brand-ai">ai</span><span class="brand-dot">.</span></a
            ><p>
              Free chart makers, math tools<br />& printable resources.
            </p>
          </div><div>
            <span class="footer-label">MAKE SOMETHING</span><a href="/charts/">All eight chart makers</a><a
              href="/dot-plot-maker/">Dot plot maker</a
            ><a href="/radar-chart-maker/">Radar chart maker</a><a href="/line-graph-maker/"
              >Line graph maker</a
            ><a href="/printables/habit-tracker/">Habit tracker printable</a><a href="/math-tools/"
              >Free math tools & worksheets</a
            >
          </div><div>
            <span class="footer-label">THE DETAILS</span><a href="/guides/">Chart guides</a><a
              href="/datasets/">Public datasets</a
            ><a href="/about/">About & methodology</a><a href="/source/">Source code & reuse</a><a
              href="/privacy/">Privacy</a
            ><a href="mailto:support@chartsai.com">Send feedback ↗</a>
          </div><div class="footer-credit">
            <span class="footer-label">MADE WITH INTENTION</span><p>
              Designed and built by<br /><a href="https://www.supamakers.com/">SupaMakers ↗</a>
            </p><span class="fine-print">Free to use. Open to build on.</span>
          </div>
        </div><div class="footer-bottom">
          <span>© 2026 SupaMakers Limited</span><span>No accounts. No watermarks. Just useful tools.</span><a
            href="/terms/">Terms of use</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
